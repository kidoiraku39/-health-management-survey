# Vercel の Environment Variables に設定する値の例（このファイルは設定の一覧です。実際の値はVercelに入力してください）

# GASのウェブアプリURL（必須。未設定だと従業員の画面は「準備中」になる）
VITE_GAS_WEB_APP_URL=https://script.google.com/macros/s/xxxxxxxx/exec

# 同意画面に表示する運営者情報（3つとも必須。未設定だと従業員の画面は「準備中」になる）
VITE_OPERATOR_NAME=運営者名
VITE_OPERATOR_CONTACT=contact@example.com
VITE_OPERATOR_RETENTION=回答から12か月
